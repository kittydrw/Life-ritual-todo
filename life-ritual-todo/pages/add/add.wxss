/* pages/add/add.wxss */
.page-root {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: var(--card);
  box-shadow: 0 4rpx 16rpx var(--shadow);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-icon {
  font-size: 36rpx;
  color: var(--text);
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  font-family: var(--font-family);
}

.nav-spacer {
  width: 72rpx;
}

.scroll {
  flex: 1;
  min-height: 0;
}

.form {
  padding: 16rpx 40rpx 0;
}

.field {
  background: var(--card);
  border-radius: 28rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx var(--shadow);
}

.field-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 24rpx;
  font-weight: 500;
}

.ph {
  color: var(--text-3);
}

/* 自定义 Emoji 输入 */
.emoji-custom {
  margin-top: 20rpx;
  background: var(--card-2);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  font-size: 30rpx;
  line-height: 1.4;    
  height: 72rpx;     
  color: var(--text);
  width: 100%;
  box-sizing: border-box;
}

/* 标题输入 */
.title-input {
  font-size: 32rpx;
  color: var(--text);
  padding: 14rpx 0;     
  line-height: 1.5;    
  height: 76rpx;     
  width: 100%;
}

/* 时间模式 Tabs */
.type-tabs {
  display: flex;
  background: var(--card-2);
  border-radius: 48rpx;
  padding: 8rpx;
  margin-bottom: 26rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 14rpx 0;
  border-radius: 40rpx;
  transition: all 0.2s ease;
}

.type-tab.active {
  background: var(--primary);
  color: var(--fab-text);
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx var(--primary-soft);
}

/* 日期/时间选择 */
.picker-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.picker-item {
  display: inline-flex;
  align-items: center;
  background: var(--card-2);
  border-radius: 20rpx;
  padding: 16rpx 22rpx;
}

.picker-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.picker-text {
  font-size: 28rpx;
  color: var(--text);
  font-family: var(--font-family);
}

.picker-sep {
  color: var(--text-3);
}

/* 分区网格 */
.cats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cat-item {
  display: inline-flex;
  align-items: center;
  background: var(--card-2);
  border: 2rpx solid transparent;
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  transition: all 0.15s ease;
}

.cat-item.active {
  border-color: var(--primary);
  background: var(--primary-soft);
}

.cat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.cat-name {
  font-size: 26rpx;
  color: var(--text);
}

.add-cat {
  border-style: dashed;
  border-color: var(--text-3);
  background: transparent;
}

.cat-add {
  color: var(--text-2);
  font-size: 26rpx;
  margin-right: 8rpx;
}

/* 备注 */
.note-input {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.6;
}

.form-bottom {
  height: 40rpx;
}

/* 底部操作栏 */
.footer {
  /*position: fixed;
  left: 0;
  right: 0;
  bottom: 0;*/
  display: flex;
  padding: 24rpx 40rpx 28rpx;
  background: var(--bg);
  box-shadow: 0 -4rpx 20rpx var(--shadow);
  gap: 24rpx;
}

.footer-btn {
  text-align: center;
  font-size: 30rpx;
  padding: 24rpx 0;
  border-radius: 48rpx;
}

.del-btn,
.cancel-btn {
  flex: 1;
  background: var(--card);
  color: var(--text-2);
}

.del-btn {
  color: var(--overdue);
}

.save-btn {
  flex: 2;
  background: var(--primary);
  color: var(--fab-text);
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx var(--primary-soft);
}

.footer-hover {
  transform: scale(0.97);
  opacity: 0.9;
}
