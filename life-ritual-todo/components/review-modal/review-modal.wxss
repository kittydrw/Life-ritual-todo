.r-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 999;
  animation: rFadeIn 0.25s ease;
}

.r-card {
  width: 100%;
  background: var(--card);
  border-radius: 40rpx 40rpx 0 0;
  padding: 50rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));
  animation: rSlideUp 0.35s cubic-bezier(0.34, 1.3, 0.64, 1);
  max-height: 80vh;
  overflow-y: auto;
}

.r-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  text-align: center;
}

.r-task {
  font-size: 28rpx;
  color: var(--text-2);
  text-align: center;
  margin: 12rpx 0 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.r-label {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 16rpx;
}

.r-moods {
  display: flex;
  justify-content: space-between;
  margin-bottom: 34rpx;
}

.r-mood {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  border-radius: 20rpx;
  background: var(--card-2);
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}

.r-mood.active {
  background: var(--primary-soft);
  border-color: var(--primary);
  transform: scale(1.12);
}

.r-stars {
  display: flex;
  justify-content: center;
  margin-bottom: 34rpx;
}

.r-star {
  font-size: 56rpx;
  margin: 0 10rpx;
  transition: transform 0.15s ease;
}

.r-star:active {
  transform: scale(1.25);
}

.r-note {
  width: 100%;
  height: 120rpx;
  background: var(--card-2);
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--text);
  margin-bottom: 40rpx;
}

.r-note-ph {
  color: var(--text-3);
}

.r-btns {
  display: flex;
  align-items: center;
}

.r-skip {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-2);
  padding: 22rpx 0;
  border-radius: 48rpx;
  background: var(--card-2);
  margin-right: 24rpx;
}

.r-submit {
  flex: 2;
  text-align: center;
  font-size: 30rpx;
  color: var(--fab-text);
  background: var(--primary);
  padding: 22rpx 0;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 20rpx var(--primary-soft);
}

.r-hover {
  transform: scale(0.97);
  opacity: 0.9;
}

@keyframes rFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes rSlideUp {
  from { opacity: 0; transform: translateY(100%); }
  to { opacity: 1; transform: translateY(0); }
}
