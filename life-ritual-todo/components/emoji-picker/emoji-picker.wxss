.emoji-scroll {
  width: 100%;
  white-space: nowrap;
}

.emoji-list {
  display: inline-flex;
  padding: 8rpx 4rpx;
}

.emoji-item {
  width: 88rpx;
  height: 88rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  background: var(--card-2);
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
  flex-shrink: 0;
}

.emoji-item.active {
  background: var(--primary-soft);
  border-color: var(--primary);
  transform: scale(1.08);
}
