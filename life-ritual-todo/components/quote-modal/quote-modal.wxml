    <view class="q-deco">🕯️</view>
    <view class="q-title">仪式感时刻</view>
    <view class="q-quote">“{{quote}}”</view>
    <view class="q-btn" hover-class="q-btn-hover" bindtap="onStart">开始今日仪式</view>
  </view>
</view>
