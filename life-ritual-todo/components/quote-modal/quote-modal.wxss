.q-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  animation: qFadeIn 0.3s ease;
}

.q-card {
  width: 600rpx;
  background: var(--card);
  border-radius: 36rpx;
  padding: 70rpx 50rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  animation: qPop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.q-deco {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.q-title {
  font-size: 34rpx;
  color: var(--text);
  font-family: var(--font-family);
  margin-bottom: 30rpx;
}

.q-quote {
  font-size: 30rpx;
  color: var(--text-2);
  text-align: center;
  line-height: 1.7;
  min-height: 130rpx;
  font-family: var(--font-family);
}

.q-btn {
  margin-top: 44rpx;
  background: var(--primary);
  color: var(--fab-text);
  font-size: 30rpx;
  padding: 20rpx 70rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 20rpx var(--primary-soft);
}

.q-btn-hover {
  transform: scale(0.96);
  opacity: 0.9;
}

@keyframes qFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes qPop {
  from { opacity: 0; transform: scale(0.8) translateY(30rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}
